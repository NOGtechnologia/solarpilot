# Kopieren nach .env und anpassen. Keine echten Zugangsdaten committen!

# Port, unter dem das Dashboard erreichbar ist (docker compose)
SOLARPILOT_PORT=8080

# Geheimer Schlüssel für Login-Tokens und die Verschlüsselung gespeicherter Zugangsdaten.
# Leer lassen = wird beim ersten Start erzeugt und in /data/secret.key gespeichert.
# Erzeugen z. B. mit:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SOLARPILOT_SECRET_KEY=

# Demo-Anlage beim ersten Start automatisch anlegen (für Live-Demos)
SOLARPILOT_DEMO=false

# Abfrage- und Speicherintervall
SOLARPILOT_POLL_INTERVAL_S=10
SOLARPILOT_STORE_INTERVAL_S=60

# Optional: PostgreSQL / TimescaleDB statt SQLite
# SOLARPILOT_DATABASE_URL=postgresql+psycopg://solarpilot:passwort@db:5432/solarpilot

# Optional: Konfigurationsdatei mit Anlagen (siehe config/sites.example.yaml)
# SOLARPILOT_SITES_FILE=/app/config/sites.yaml

# Cookies nur über HTTPS senden (hinter einem Reverse-Proxy mit TLS aktivieren)
SOLARPILOT_COOKIE_SECURE=false

# Wie lange Minutenwerte aufbewahrt werden (Tage)
SOLARPILOT_RETENTION_DAYS=730

SOLARPILOT_LOG_LEVEL=INFO
